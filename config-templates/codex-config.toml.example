# Optional project-local template. Check support, then copy to .codex/config.toml.
# No credentials, global settings, or permission overrides.
model = "gpt-6-astra"
model_reasoning_effort = "high"

[agents]
enabled = true
default_subagent_model = "gpt-5.6-luna"
default_subagent_reasoning_effort = "medium"
max_concurrent_threads_per_session = 2
